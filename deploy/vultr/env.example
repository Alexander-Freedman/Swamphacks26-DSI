# /etc/mm/env: read by uvicorn (--env-file). Owner mm:mm, mode 600. Never commit real values.
# Empty GEMINI_API_KEY = offline mode: showcase + reviewed rounds still work, help falls back to static hints.
GEMINI_API_KEY=
# Not read by the API yet (Tiger work is #100); local SQLite under data/ until then.
TIGER_DATABASE_URL=
# Comma-separated exact origins allowed to call the API from a browser.
MM_CORS_ORIGINS=https://alexander-freedman.github.io

# Optional knobs: leave commented to keep the code defaults (an empty value would break int parsing).
# MM_OFFLINE=1
# MM_DB=/opt/mm/data/local.db
# MM_PER_IP_PER_HOUR=12
# MM_ANSWERS_PER_IP_PER_HOUR=600
# HELP_DAILY_CAP=150
# HELP_PER_IP=10
# HELP_PER_IP_WINDOW_S=600
