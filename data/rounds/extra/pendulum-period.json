  "misconceptions": [
    {
      "id": "linear-length",
      "label": "4x the length, 4x the time",
      "why_tempting": "Longer should mean proportionally slower.",
      "refutation": "Swing time grows with the square root of length: 4x longer is only 2x slower.",
      "source_url": "https://en.wikipedia.org/wiki/Pendulum_(mechanics)",
      "source_note": "Page states the correct model; that this mistake is common is unverified"
    },
    {
      "id": "length-doesnt-matter",
      "label": "Length barely matters",
      "why_tempting": "Swings seem to keep a steady beat, like a clock.",
      "refutation": "Length sets the beat: T = 2 pi sqrt(L/g), so a 4 m pendulum takes 4 s.",
      "source_url": "https://en.wikipedia.org/wiki/Pendulum_(mechanics)",
      "source_note": "Page states the correct model; that this mistake is common is unverified"
    }
