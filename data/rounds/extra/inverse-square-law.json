  "topic": "The inverse-square law",
  "concept": "geometry of spreading",
  "reviewed": true,
  "misconceptions": [
    {
      "id": "inverse-not-square",
      "label": "Four times farther, a quarter as bright",
      "why_tempting": "Brightness dropping with distance sounds like a simple ratio.",
      "refutation": "Light spreads over an area that grows with distance squared: 4 times farther is 16 times dimmer.",
      "source_url": "https://en.wikipedia.org/wiki/Inverse-square_law",
      "source_note": "Page states the correct model; that this mistake is common is unverified"
    },
    {
      "id": "linear-falloff",
      "label": "Drops a little each meter",
      "why_tempting": "It feels like brightness fades by a fixed amount per meter.",
      "refutation": "It falls off with the square of distance, so it fades fast: 16/4^2 = 1.",
      "source_url": "https://en.wikipedia.org/wiki/Inverse-square_law",
      "source_note": "Page states the correct model; that this mistake is common is unverified"
    }
  ],
